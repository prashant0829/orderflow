root = true
[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
charset = utf-8
[*.{json,yml,yaml,ts,tsx,css}]
indent_size = 2
[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
# Readability over micro-optimisation: allow plain ILogger calls and meaningful handler parameter names
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1725.severity = none

[**/Migrations/*.cs]
generated_code = true

[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
# xUnit fixtures are disposed through IAsyncLifetime, and xUnit names its own collection types "...Collection"
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1822.severity = none
