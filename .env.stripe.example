# Copy to .env.stripe (git-ignored) and fill in your TEST keys from https://dashboard.stripe.com/test/apikeys
# scripts/dev-up.sh loads .env.stripe automatically when it exists.
Payments__Provider=Stripe
Stripe__SecretKey=sk_test_REPLACE_ME
Stripe__PublishableKey=pk_test_REPLACE_ME
# Optional: only needed for the webhook path. `scripts/stripe-listen.sh` prints the value (whsec_...).
Stripe__WebhookSecret=
