    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rabbitmq_detailed_queue_messages{queue=~\".*_error\"}) or vector(0)",
     "legendFormat": "",
     "refId": "A"
