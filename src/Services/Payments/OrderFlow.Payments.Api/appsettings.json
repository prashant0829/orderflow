{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "ConnectionStrings": {
    "PaymentsDb": ""
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "FakePaymentGateway": {
    "DeclineRate": 0.0,
    "TransientFailureRate": 0.0,
    "LatencyMs": 50
  },
  "PaymentResilience": {
    "RetryCount": 3,
    "RetryBaseDelayMs": 200,
    "AttemptTimeoutSeconds": 5,
    "FailureRatio": 0.5,
    "MinimumThroughput": 6,
    "SamplingDurationSeconds": 30,
    "BreakDurationSeconds": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "orderflow-identity",
    "Audience": "orderflow-api",
    "SigningKey": ""
  }
}