{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6380"
  },
  "Jwt": {
    "Issuer": "orderflow-identity",
    "Audience": "orderflow-api",
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "RateLimit": {
    "Enabled": true,
    "Auth": {
      "Limit": 10,
      "WindowSeconds": 60
    },
    "Authenticated": {
      "Limit": 120,
      "WindowSeconds": 60
    },
    "Anonymous": {
      "Limit": 60,
      "WindowSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      },
      "admin": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        }
      },
      "stock-read": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/stock/{**catch-all}",
          "Methods": [
            "GET"
          ]
        }
      },
      "stock-write": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/v1/stock/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "DELETE"
          ]
        }
      },
      "payments": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        }
      },
      "timeline": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/timeline/{**catch-all}"
        }
      },
      "hubs": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "payments-customer": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/payments/order/{orderId}/{action}",
          "Methods": [
            "GET",
            "POST"
          ]
        }
      },
      "payments-webhook": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/payments/webhooks/{**catch-all}",
          "Methods": [
            "POST"
          ]
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5105/"
          }
        }
      },
      "orders": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "payments": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "notifications": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104/"
          }
        }
      }
    }
  }
}
